# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# CHỈ đặt ở server. TUYỆT ĐỐI không đưa vào app Expo / không commit lên git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Server ---
PORT=4000
NODE_ENV=development
# Danh sách origin được phép (chỉ cần cho web, app mobile không cần CORS). Cách nhau bởi dấu phẩy
CORS_ORIGINS=
# Đặt 1 nếu chạy sau reverse proxy / load balancer (Render, Railway, Nginx...)
TRUST_PROXY=0

# --- Nghiệp vụ ---
SCHOOL_TZ=Asia/Ho_Chi_Minh
EMAIL_DOMAIN=school.local
CURRENT_SEMESTER=1
