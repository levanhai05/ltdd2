{
  "name": "school-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend REST API (Node.js + Express) cho school-app, dùng Supabase làm DB + Auth",
  "engines": { "node": ">=20" },
  "scripts": {
